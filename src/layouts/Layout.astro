---
import '../styles.css'

interface Props {
  locale: 'zh' | 'en'
  title: string
  description: string
  canonicalPath?: '/' | '/en/'
  robots?: string
}

const {
  locale,
  title,
  description,
  canonicalPath,
  robots = 'index, follow, max-image-preview:large'
} = Astro.props
const site = Astro.site ?? new URL('https://agent-launcher-homepage.whitematrix.workers.dev')
const canonicalUrl = canonicalPath ? new URL(canonicalPath, site) : undefined
const imageUrl = new URL('/images/agent-launcher-workspace@2x.webp?v=3', site)
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Agent Launcher',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: ['macOS', 'Windows', 'Linux'],
  description,
  ...(canonicalUrl ? { url: canonicalUrl.toString() } : {}),
  downloadUrl: 'https://github.com/WhiteMatrixTech/agent-launcher/releases',
  codeRepository: 'https://github.com/WhiteMatrixTech/agent-launcher',
  license: 'https://github.com/WhiteMatrixTech/agent-launcher/blob/main/LICENSE',
  author: {
    '@type': 'Organization',
    name: 'WhiteMatrixTech'
  },
  inLanguage: locale === 'zh' ? 'zh-CN' : 'en'
}
---

<!doctype html>
<html lang={locale === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#f6f6f3" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="alternate" hreflang="zh-CN" href={new URL('/', site)} />
    <link rel="alternate" hreflang="en" href={new URL('/en/', site)} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', site)} />
    <link rel="sitemap" href={new URL('/sitemap-index.xml', site)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Agent Launcher" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:locale" content={locale === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="2360" />
    <meta property="og:image:height" content="1520" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="icon" type="image/png" href="/app-icon.png" />
    <link rel="apple-touch-icon" href="/app-icon.png" />
    <title>{title}</title>
    <script is:inline>document.documentElement.classList.add('js')</script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <slot />
  </body>
</html>
